{
  "name": "cyberai-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite web --config vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit && vite build web --config vite.config.ts",
    "preview": "vite preview web --config vite.config.ts --host 0.0.0.0",
    "data:import": "python3 scripts/import_workbook.py",
    "test:data": "python3 -m unittest discover -s tests -v",
    "test:web": "node tests/browser.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "@playwright/test": "^1.51.0"
  }
}
